{
  "name": "appointment-portal",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.0.1"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "typecheck": "pnpm -r typecheck && tsc -p scripts/tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "lint": "eslint .",
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @portal/web --filter @portal/api dev",
    "check:bundles": "node scripts/check-bundles.ts",
    "check:artifacts": "node scripts/check-artifacts.ts",
    "check:infra": "node scripts/check-infra.ts",
    "test:e2e": "playwright test --project=local-desktop --project=local-mobile",
    "db:setup:aws": "tsx scripts/provision.ts",
    "demo:prepare": "tsx scripts/prepare-demo-config.ts",
    "demo:preflight": "tsx scripts/preflight-cli.ts .runtime/demo-config.json",
    "demo:setup-delivery": "tsx scripts/setup-delivery.ts .runtime/demo-config.json",
    "demo:deploy": "tsx scripts/deploy-cli.ts .runtime/demo-config.json",
    "demo:verify": "tsx scripts/verify-deployment.ts",
    "demo:confirm-registration": "tsx scripts/manual-registration.ts",
    "demo:measure": "tsx scripts/measure-web.ts",
    "demo:diagnostics": "tsx scripts/capture-diagnostics.ts",
    "demo:destroy": "tsx scripts/cleanup.ts",
    "demo:verify-cleanup": "tsx scripts/verify-cleanup.ts",
    "demo:restore-manifest": "tsx scripts/destroy-provenance.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "3.1127.0",
    "@aws-sdk/client-cloudfront": "3.1127.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1127.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1127.0",
    "@aws-sdk/client-ec2": "3.1127.0",
    "@aws-sdk/client-ecr": "3.1127.0",
    "@aws-sdk/client-iam": "3.1127.0",
    "@aws-sdk/client-lambda": "3.1127.0",
    "@aws-sdk/client-rds": "3.1127.0",
    "@aws-sdk/client-s3": "3.1127.0",
    "@aws-sdk/client-secrets-manager": "3.1127.0",
    "@aws-sdk/client-ssm": "3.1127.0",
    "@aws-sdk/client-sts": "3.1127.0",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.63.0",
    "@types/pg": "8.15.5",
    "esbuild": "0.25.12",
    "eslint": "9.36.0",
    "jsdom": "26.1.0",
    "lighthouse": "13.4.1",
    "pg": "8.16.3",
    "puppeteer-core": "25.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "3.2.6",
    "yaml": "2.9.0",
    "zod": "4.1.12"
  }
}
